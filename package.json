{
  "name": "velia",
  "version": "1.0.0",
  "description": "French privacy-first messaging app - Made in France",
  "private": true,
  "author": "Benoit Bremaud <benoit.bremaud@outlook.fr>",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive run dev",
    "dev:mobile": "pnpm --filter velia-mobile run dev",
    "dev:backend": "pnpm --filter velia-backend run dev",
    "build": "pnpm --recursive run build",
    "build:mobile": "pnpm --filter velia-mobile run build",
    "build:backend": "pnpm --filter velia-backend run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "test": "pnpm --recursive run test",
    "test:coverage": "pnpm --recursive run test:coverage",
    "test:watch": "pnpm --recursive run test:watch",
    "quality": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "velia",
    "messaging",
    "privacy",
    "france",
    "react-native",
    "nestjs"
  ]
}
