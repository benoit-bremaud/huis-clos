#!/bin/sh

# Commit-msg hook to validate commit message format

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check if commit message matches conventional commit format
if echo "$COMMIT_MSG" | grep -E '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|hotfix)(\([a-z0-9-]+\))?: .+' > /dev/null; then
  echo "✅ Commit message is valid"
  exit 0
else
  echo ""
  echo "❌ Invalid commit message: $COMMIT_MSG"
  echo ""
  echo "Expected format: type(scope): subject"
  echo "Examples:"
  echo "  - feat(auth): add login feature"
  echo "  - fix(profile): resolve avatar upload error"
  echo "  - docs(contributing): add branching policy"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, hotfix"
  echo ""
  exit 1
fi
