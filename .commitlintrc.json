{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
        "hotfix"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "auth",
        "profile",
        "chat",
        "contacts",
        "notification",
        "i18n",
        "infra",
        "docs",
        "ci",
        "mobile",
        "backend",
        "shared",
        "api",
        "contributing"
      ]
    ],
    "subject-case": [2, "always", ["sentence-case"]],
    "subject-empty": [2, "never"],
    "subject-min-length": [2, "always", 3],
    "subject-max-length": [2, "always", 72],
    "body-max-line-length": [2, "always", 100]
  }
}
